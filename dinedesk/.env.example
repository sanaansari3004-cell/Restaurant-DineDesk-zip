# Copy to .env and fill in. Never commit a real .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://dinedesk:dinedesk@localhost:5433/dinedesk?schema=public"

# Secret used to sign staff JWT session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Demo seed credentials are created by `npm run db:seed`
# (see README "Demo credentials").
